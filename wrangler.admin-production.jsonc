{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcitcs-admin-production",
  "main": "./worker/admin-only.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "keep_vars": true,
  "vars": {
    "RC_ADMIN_BUILD_SURFACE": "phase16-security-closure-v1",
    "RC_ADMIN_HTML_MEDIA_FIX": "phase16-html-content-type-v1",
    "RC_ADMIN_ENVIRONMENT": "production"
  },
  "routes": [
    {
      "pattern": "admin.rcitcs.com",
      "custom_domain": true
    }
  ]
}
