{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcitcservices",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "rcitcs.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rcitcs.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
