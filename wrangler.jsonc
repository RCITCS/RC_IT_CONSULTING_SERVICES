{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcitcservices",
  "main": "./worker/admin-domain-entry.js",
  "compatibility_date": "2026-09-08",
  "routes": [
    {
      "pattern": "admin-staging.rcitcs.com/*",
      "zone_name": "rcitcs.com"
    },
    {
      "pattern": "admin.rcitcs.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_CAREERS_API_URL": "https://chsizmffzpxcqhaptjeu.supabase.co/functions/v1/public-careers",
    "ADMIN_PROXY_BASE": "/admin",
    "ADMIN_PROXY_WILDCARD": "/admin/*"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*"]
  }
}
