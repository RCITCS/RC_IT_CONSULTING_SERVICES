{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcitcservices",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "PUBLIC_CAREERS_API_URL": "https://chsizmffzpxcqhaptjeu.supabase.co/functions/v1/public-careers"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/careers", "/careers/jobs/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
