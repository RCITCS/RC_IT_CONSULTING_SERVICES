{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcitcservices",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/careers", "/careers/jobs/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "RCITCS_ENV": "production"
  }
}
